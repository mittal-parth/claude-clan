    "fastify": "^5.11.2",
    "pg": "^8.16.0",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/ws": "^8.18.1",
