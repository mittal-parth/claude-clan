# Copy to .env.local for local development, or set these as build-time
# environment variables on Vercel (a static build bakes them in -- there is
# no runtime env for a Vite app).

VITE_WS_URL=ws://127.0.0.1:4100/ws
VITE_API_URL=http://127.0.0.1:4100
VITE_MAX_BUDGET_USD=1

# PostHog Analytics (optional)
# Set VITE_POSTHOG_KEY to your PostHog project API key (e.g. phc_...) to enable telemetry.
# Omit to run in silent no-op mode without error.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
