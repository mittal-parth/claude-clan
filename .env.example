# Copy to .env for local development (apps/server/src/index.ts loads this
# automatically when ANTHROPIC_API_KEY isn't already set), or set these as
# environment variables on your Render service for a deployment.

# Claude access. Omit entirely to fall back to a local Claude Code login.
ANTHROPIC_API_KEY=

# --- GitHub login (all five required together, or all omitted) -------------
#
# 1. Create a GitHub App at https://github.com/settings/apps/new
#    - Callback URL: https://<your-server-host>/auth/github/callback
#    - "Request user authorization (OAuth) during installation": ON
#    - "Expire user authorization tokens": ON (leave the 8h/6mo defaults)
#    - Webhook: OFF (not used)
#    - Repository permissions: Contents (read), Pull requests (read & write),
#      Issues (read), Metadata (read)
#    - "Where can this GitHub App be installed?": Any account
# 2. Generate a client secret on the App's settings page.
# 3. Fill in the four values below from that same page.
# 4. Create a Postgres database (e.g. a free Supabase project) and set
#    DATABASE_URL below -- sessions and imported-repo tracking are stored
#    there (tables are created automatically on boot).
#
# Leaving these unset disables login entirely -- the server still runs and
# serves the demo city with zero configuration.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
# HMAC key for the login flow's CSRF state param -- any random string.
SESSION_SECRET=
# Use a connection pooler (e.g. Supabase's "Session pooler", port 6543) for
# a long-running server rather than the direct connection.
DATABASE_URL=

# The web app's origin, used for the post-login redirect and CORS. In local
# dev this is Vite's dev server.
WEB_ORIGIN=http://127.0.0.1:5173

# --- optional --------------------------------------------------------------
SUDO_CITY_REPO=
SUDO_CITY_MAX_BUDGET_USD=1
# Where per-user repo clones are cached; defaults to <tmpdir>/sudocity.
SUDO_CITY_CLONE_ROOT=
HOST=127.0.0.1
PORT=4100
