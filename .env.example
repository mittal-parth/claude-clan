# Copy to .env for local development (apps/server/src/index.ts loads this
# automatically when ANTHROPIC_API_KEY isn't already set), or set these as
# environment variables on your Render service for a deployment.

# Claude access. Omit entirely to fall back to a local Claude Code login.
ANTHROPIC_API_KEY=

# --- GitHub login (all six required together, or all omitted) --------------
#
# 1. Create a GitHub App at https://github.com/settings/apps/new
#    - Callback URL: https://<your-server-host>/auth/github/callback
#    - "Request user authorization (OAuth) during installation": ON
#    - "Expire user authorization tokens": ON (leave the 8h/6mo defaults)
#    - Webhook: OFF (not used)
#    - Repository permissions: Contents (read), Pull requests (read & write),
#      Issues (read), Metadata (read)
#    - "Where can this GitHub App be installed?": Any account
# 2. Generate a client secret on the App's settings page.
# 3. Fill in the four values below from that same page.
# 4. Create a Postgres database (e.g. a free Supabase project) and set
#    DATABASE_URL below -- sessions and imported-repo tracking are stored
#    there (tables are created automatically on boot).
#
# Leaving these unset disables login entirely -- the server still runs and
# serves the demo city with zero configuration.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
# HMAC key for the login flow's CSRF state param -- any random string.
SESSION_SECRET=
# Encrypts the GitHub tokens stored on each session row, so a database dump
# is not a set of working credentials. Any random string; generate one with
# `openssl rand -base64 32`. Keep it: changing it makes every existing
# session unreadable and signs everyone out.
TOKEN_ENCRYPTION_KEY=
# Use a connection pooler (e.g. Supabase's "Session pooler", port 6543) for
# a long-running server rather than the direct connection.
DATABASE_URL=

# The web app's origin, used for the post-login redirect and CORS. In local
# dev this is Vite's dev server.
WEB_ORIGIN=http://127.0.0.1:5173

# --- PostHog Analytics (optional) ------------------------------------------
# Set VITE_POSTHOG_KEY to your PostHog project API key (e.g. phc_...) to enable telemetry.
# Omit to run in silent no-op mode without error.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# --- optional --------------------------------------------------------------
SUDO_CITY_REPO=
SUDO_CITY_MAX_BUDGET_USD=1
# Lifetime Anthropic spend allowed per signed-in user, in dollars. Tracked in
# the user_spend table, so it survives restarts and applies across instances.
# An order is capped by whichever runs out first, this or the shared ceiling.
SUDO_CITY_USER_MAX_BUDGET_USD=10
# Set this on any server strangers can reach. It disables the Opus crew and
# the "extra high"/"max" thinking levels (one shared Anthropic ceiling funds
# every visitor), and makes the demo city read-only -- orders there are
# unauthenticated, so anyone could otherwise dispatch a crew on the server's
# own checkout. Leave it unset for local development.
SUDO_CITY_PUBLIC_DEPLOYMENT=
# Where per-user repo clones are cached; defaults to <tmpdir>/sudocity.
# Use an absolute path -- a relative one resolves against the server's working
# directory and drops clones inside the checkout. Leaving it blank is fine.
SUDO_CITY_CLONE_ROOT=
HOST=127.0.0.1
PORT=4100
